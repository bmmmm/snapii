{
  "name": "snapii",
  "version": "0.2.0",
  "private": true,
  "description": "Browser extension (Firefox, Chromium): save a page region as SVG with real, selectable text and clickable links.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "node -e \"if(!(process.env.npm_config_user_agent||'').startsWith('pnpm')){console.error('\\nUse pnpm, not npm/yarn: https://pnpm.io/installation\\n');process.exit(1)}\"",
    "check": "tsc --noEmit && tsc --noEmit -p tests && biome check .",
    "format": "biome check --write .",
    "test": "node --test 'tests/unit/**/*.test.ts' && playwright test",
    "test:glue": "node scripts/build.mjs && node --test tests/glue/",
    "build": "node scripts/build.mjs",
    "lint:ext": "web-ext lint --source-dir dist",
    "package": "web-ext build --source-dir dist --artifacts-dir web-ext-artifacts --overwrite-dest",
    "package:chromium": "web-ext build --source-dir dist-chromium --artifacts-dir web-ext-artifacts --filename snapii-chromium-{version}.zip --overwrite-dest",
    "start": "web-ext run --firefox=/Applications/Firefox.app/Contents/MacOS/firefox --source-dir dist",
    "drive": "node tools/drive/cli.mjs",
    "test:glue:chromium": "node scripts/build.mjs && node --test \"tests/glue-chromium/*.test.mjs\""
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "web-ext": "^10.7.0"
  },
  "dependencies": {
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "text-fragments-polyfill": "^6.7.0"
  }
}
