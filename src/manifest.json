{
  "manifest_version": 3,
  "name": "snapii",
  "version": "0.0.0",
  "description": "Save a page region as SVG with real, selectable text and clickable links.",
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "action": {
    "default_title": "snapii: capture region as SVG",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup.html"
  },
  "commands": {
    "start-capture": { "suggested_key": { "default": "Ctrl+Alt+S", "mac": "Command+Shift+E" }, "description": "Capture a region" },
    "_execute_action": { "description": "Open the snapii menu" }
  },
  "background": { "scripts": ["background.js"] },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; upgrade-insecure-requests" },
  "permissions": ["activeTab", "scripting", "downloads", "clipboardWrite", "storage"],
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "browser_specific_settings": {
    "gecko": {
      "id": "snapii@qmmq.de",
      "strict_min_version": "157.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
